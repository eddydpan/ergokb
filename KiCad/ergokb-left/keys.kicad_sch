	(text "Data enters at LED24 (outer num, next to the MCU) and snakes through the keys so every DOUT -> DIN trace is a short hop to the neighbouring key:\nouter down, pinky up, ring down, middle up, index down, thumbs (palm, curl, extra, home), inner up. LED and cap numbers match the key's switch number."
		(exclude_from_sim no)
		(at 187.96 21.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "06a5639a-d8c9-4398-82f1-cd9e0ecfcb46")
